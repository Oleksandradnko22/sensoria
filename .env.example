# Copy this file to .env.local (already gitignored via the *.local rule)
# and fill in the real values from your Supabase project settings
# (Project Settings -> API). The anon/public key is safe to expose in
# frontend code by design — it's meant to be embedded in browser
# bundles, access is controlled by Row Level Security policies on the
# database side, not by keeping this key secret.
#
# Never put the "service_role" key here — that one bypasses RLS
# entirely and must never reach the browser.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Set to false to hide the demo programs and show only real published ones.
# VITE_SHOW_DEMO_PROGRAMS=true
